---
import type { Project } from '../data/portfolio';
import MediaPlaceholder from './MediaPlaceholder.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const featuredProject = projects.find((project) => project.featured) ?? projects[0];
const secondaryProjects = projects.filter((project) => project !== featuredProject);

const externalProps = (href?: string, external?: boolean) => ({
  href,
  target: external ? '_blank' : undefined,
  rel: external ? 'noreferrer' : undefined,
});
---

<section id="proyectos" class="section projects-section" aria-labelledby="projects-title">
  <SectionHeading
    id="projects-title"
    eyebrow="03 / PROJECTS"
    title="Trabajo abierto, ideas en movimiento."
    description="Una selección de proyectos para explorar decisiones, herramientas y resultados."
  />

  {featuredProject && (
    <article class:list={['featured-project', { 'featured-project--placeholder': featuredProject.placeholder }]} data-reveal>
      <div class="featured-project__content">
        <div class="project-meta">
          <span>FEATURED / 01</span>
          {featuredProject.openSource && <span class="project-meta__accent">OPEN SOURCE</span>}
        </div>
        <h3>{featuredProject.title}</h3>
        <p>{featuredProject.description}</p>
        <div class="project-details">
          {featuredProject.year && <span>{featuredProject.year}</span>}
          {featuredProject.status && <span>{featuredProject.status}</span>}
        </div>
        <ul class="tag-list" aria-label={`Tecnologías de ${featuredProject.title}`}>
          {featuredProject.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
        <div class="project-links">
          {featuredProject.repository && (
            <a class="text-link" {...externalProps(featuredProject.repository, true)}>
              Ver repositorio <span aria-hidden="true">↗</span>
            </a>
          )}
          {featuredProject.demo && (
            <a class="text-link" {...externalProps(featuredProject.demo, true)}>
              Ver demo <span aria-hidden="true">↗</span>
            </a>
          )}
          {!featuredProject.repository && !featuredProject.demo && (
            <span class="project-pending">Enlace pendiente de agregar</span>
          )}
        </div>
      </div>
      <MediaPlaceholder
        src={featuredProject.image?.src}
        alt={featuredProject.image?.alt}
        label="PROJECT PREVIEW"
        variant="project"
      />
    </article>
  )}

  {secondaryProjects.length > 0 && (
    <div class="project-index" aria-label="Índice de proyectos">
      <div class="project-index__header" aria-hidden="true">
        <span>INDEX</span>
        <span>PROJECT / STATUS / YEAR</span>
        <span>LINK</span>
      </div>
      {secondaryProjects.map((project, index) => (
        <article class:list={['project-row', { 'project-row--placeholder': project.placeholder }]} data-reveal>
          <span class="project-row__number">{String(index + 2).padStart(2, '0')}</span>
          <div class="project-row__main">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul class="tag-list" aria-label={`Tecnologías de ${project.title}`}>
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          </div>
          <div class="project-row__meta">
            <span>{project.status ?? 'Estado pendiente'}</span>
            <span>{project.year ?? '----'}</span>
          </div>
          <div class="project-row__link">
            {project.repository ? (
              <a class="circle-link" {...externalProps(project.repository, true)} aria-label={`Ver repositorio de ${project.title}`}>
                ↗
              </a>
            ) : (
              <span class="project-row__pending" aria-label={`Enlace pendiente de ${project.title}`}>Pendiente</span>
            )}
          </div>
        </article>
      ))}
    </div>
  )}
</section>
