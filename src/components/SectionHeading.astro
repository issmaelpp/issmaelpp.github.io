---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class="section-heading" data-reveal>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <div class="section-heading__content">
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>
